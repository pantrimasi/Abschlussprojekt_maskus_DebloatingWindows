<!--
    Author: Masato Kuster
    Date: 24.06.2026
    Version: 1.0.0
    Project: Windows Debloater Tool
    Description: UI layout definition for the Windows optimization tool. Contains controls, layouts and bindings for system cleanup and performance features.
-->
<UserControl x:Class="WindowsDebloater.GUI.Tabs.Optimization"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="800"
    d:DesignHeight="450" Background="#121212">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="20">
            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Animations -->
            <!-- Animation Settings -->
            <Border Background="#1A1A1A" CornerRadius="10" Margin="20" Padding="20">
                <StackPanel>
                    <TextBlock Text="Animation Settings" Foreground="#BB86FC" FontSize="24" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Default + Advanced -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <!-- Animation Default -->
                            <Border Background="#242424" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Animations Default" Foreground="#BB86FC" FontSize="20"
                                        Margin="0,0,0,10" />
                                    <CheckBox x:Name="ChkMenuDelay" Content="Menü-Verzögerung" Margin="0,0,0,8"
                                        Foreground="#9E9E9E" Checked="ChkMenuDelay_Checked" />
                                    <CheckBox x:Name="ChkTaskbarAnim" Content="Taskleisten-Animationen"
                                        Foreground="#9E9E9E" />
                                </StackPanel>
                            </Border>
                            <!-- Animation Advanced -->
                            <Border Background="#242424" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Animations Advanced" Foreground="#BB86FC" FontSize="20"
                                        Margin="0,0,0,10" />
                                    <CheckBox x:Name="ChkDynamicScrollbars" Content="Globaler Hauptschalter"
                                        Margin="0,0,0,8" Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkVisualFX" Content="Leistungsmodus" Margin="0,0,0,8"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkUserPrefMask" Content="Globaler Performance-Filter"
                                        Margin="0,0,0,8" Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkMinAnimate" Content="Fenster-Animationen" Margin="0,0,0,8"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkDragFullWindows" Content="Fenster-Inhalt" Margin="0,0,0,8"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkTransparency" Content="Transparenz" Margin="0,0,0,8"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkPreviewWindow" Content="Aero-Peek" Margin="0,0,0,8"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkSearchboxMode" Content="Startmenü-Animation" Margin="0,0,0,8"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkTouchPrediction" Content="Touch-Feedback" Margin="0,0,0,8"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkModeChangeAnim" Content="Bildschirm-Umschaltung"
                                        Foreground="#9E9E9E" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Services -->
            <!-- Service Settings -->
            <Border Background="#1A1A1A" CornerRadius="10" Margin="20" Padding="20">
                <StackPanel>
                    <TextBlock Text="Services" Foreground="#BB86FC" FontSize="24" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Gaming + Telemetry -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Gaming Services -->
                            <Border Background="#242424" CornerRadius="8" Padding="15" Margin="0,0,0,10" Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="Gaming Services" Foreground="#BB86FC" FontSize="20"
                                        Margin="0,0,0,10" />
                                    <CheckBox x:Name="ChkXboxGipSvc" Content="Xbox-Zubehör" Margin="0,0,0,5"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkXblAuthManager" Content="Xbox-Anmeldung" Margin="0,0,0,5"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkXblGameSave" Content="Xbox-Speicherstände" Margin="0,0,0,5"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkXboxNetApiSvc" Content="Xbox-Netzwerk" Foreground="#9E9E9E" />
                                </StackPanel>
                            </Border>
                            <!-- Telemetry Services -->
                            <Border Background="#242424" CornerRadius="8" Padding="15" Grid.Row="1">
                                <StackPanel>
                                    <TextBlock Text="Telemetry Services" Foreground="#BB86FC" FontSize="20"
                                        Margin="0,0,0,10" />
                                    <CheckBox x:Name="ChkDiagTrack" Content="Telemetrie-Dienst" Margin="0,0,0,5"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkWerSvc" Content="Fehlerberichte-Dienst" Margin="0,0,0,5"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkLfsvc" Content="Standort-Dienst" Margin="0,0,0,5"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkPcaSvc" Content="Kompatibilitäts-Assistent" Margin="0,0,0,5"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkPimIndex" Content="Kundenerfahrung" Margin="0,0,0,5"
                                        Foreground="#9E9E9E" />
                                    <CheckBox x:Name="ChkDps" Content="Diagnose-Richtlinie" Foreground="#9E9E9E" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- Useless Services -->
                        <Border Background="#242424" CornerRadius="8" Margin="0,0,10,0" Padding="15" Grid.Column="1">
                            <StackPanel>
                                <TextBlock Text="Useless Services" Foreground="#BB86FC" FontSize="20"
                                    Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkCscService" Content="Offlinedateien" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkIphlpsvc" Content="IP-Hilfsdienst" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkTabletInput" Content="Touch-Tastatur" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkSensorService" Content="Sensor-Dienst" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkSysMain" Content="SysMain" Margin="0,0,0,5" Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkFhsvc" Content="Dateiverlauf" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkStiSvc" Content="Scanner-Dienst" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkLmhosts" Content="NetBIOS-Hilfsdienst" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkTrkWks" Content="Verteilte Verknüpfungen" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkCertPropSvc" Content="Zertifikat-Verbreitung" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkHyperV" Content="Hyper-V" Margin="0,0,0,5" Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkWcolorcp" Content="Röhrenmonitore" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkWebClient" Content="Webclient" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkP2p" Content="Peer-Netzwerk" Foreground="#9E9E9E" />
                            </StackPanel>
                        </Border>
                        <!-- Old Services -->
                        <Border Background="#242424" CornerRadius="8" Margin="0" Padding="15" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="Old Services" Foreground="#BB86FC" FontSize="20" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkDosvc" Content="Lieferoptimierung" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkRemoteRegistry" Content="Remoteregistrierung" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkRetailDemo" Content="Retail-Demo" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkMapsBroker" Content="Offline-Karten" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkWpcMonSvc" Content="Jugendschutz" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkSCardSvr" Content="Smartcard" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkFax" Content="Fax" Margin="0,0,0,5" Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkWisvc" Content="Insider-Service" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkPhoneSvc" Content="Telefon-Dienst" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkSpooler" Content="Druckwarteschlange" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkWbioSrvc" Content="Biometrie" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkTermService" Content="Remotedesktop" Margin="0,0,0,5"
                                    Foreground="#9E9E9E" />
                                <CheckBox x:Name="ChkWwanSvc" Content="Handynetz-Hotspot" Foreground="#9E9E9E" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
