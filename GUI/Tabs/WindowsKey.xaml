<UserControl x:Class="WindowsDebloater.GUI.Tabs.WindowsKey"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="800"
    d:DesignHeight="450" Background="#121212">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="20">
            <!-- Windows Key Activation -->
            <Border Background="#1A1A1A" CornerRadius="10" Margin="20" Padding="20">
                <StackPanel>
                    <TextBlock Text="Windows Key Activation" Foreground="#BB86FC" FontSize="24" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Windows Key Activation -->
                        <Border Background="#242424" CornerRadius="8" Margin="0" Padding="15" Grid.Column="0">
                            <StackPanel>
                                <TextBlock x:Name="TxtStatus" Text="Status: Unbekannt" Foreground="#B0BEC5"
                                    FontSize="14" Margin="0,0,0,15" />
                                <TextBlock Text="Edition" Foreground="#9E9E9E" FontSize="13" Margin="0,0,0,5" />
                                <ComboBox x:Name="CmbEdition" Margin="0,0,0,15" Padding="8,5">
                                    <ComboBoxItem Content="Windows 11 Pro" />
                                    <ComboBoxItem Content="Windows 11 Home" />
                                    <ComboBoxItem Content="Windows 11 Enterprise" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnCheckStatus" Content="Status prüfen" Click="BtnCheckStatus_Click"
                                        Background="#242424" Foreground="#B0BEC5" Padding="10,8" Margin="0,0,10,0"
                                        BorderBrush="#BB86FC" BorderThickness="1" />
                                    <Button x:Name="BtnActivate" Content="Aktivieren" Click="BtnActivate_Click"
                                        Background="#BB86FC" Foreground="#121212" Padding="10,8" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
