<Window x:Class="WindowsDebloater.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:WindowsDebloater"
        mc:Ignorable="d"
        Title="WindowsDebloater" WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#121212"
        MinWidth="1200" MinHeight="800">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation bar -->
        <Grid Grid.Row="0" Background="#1A1A1A" MouseLeftButtonDown="DragWindow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="324"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0" Height="90">
                <Image Source="/GUI/Logo_Abschlussprojekt.png" Height="96" Width="101"/>
                <TextBlock Text="Windows Debloater" Foreground="#fffafa" FontSize="22" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="10,20,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NavOptimization" Text="Optimierungen" Foreground="#fffafa"
                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NavOptimization_Click"
                   FontSize="22" Margin="20,0" FontWeight="Medium"/>
                <TextBlock x:Name="NavDataProtection" Text="Datenschutz" Foreground="#fffafa"
                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NavDataProtection_Click"
                   FontSize="22" Margin="20,0" FontWeight="Medium"/>
                <TextBlock x:Name="NavApps" Text="Apps" Foreground="#fffafa"
                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NavApps_Click"
                   FontSize="22" Margin="20,0" FontWeight="Medium"/>
                <TextBlock x:Name="NavWindowsKey" Text="Windows Key" Foreground="#fffafa"
                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NavWindowsKey_Click"
                   FontSize="22" Margin="20,0" FontWeight="Medium"/>
                <TextBlock x:Name="NavProfiles" Text="Profiles" Foreground="#fffafa"
                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NavProfiles_Click"
                   FontSize="22" Margin="20,0" FontWeight="Medium"/>
                <TextBlock x:Name="NavBenchmark" Text="Benchmark" Foreground="#fffafa"
                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NavBenchmark_Click"
                   FontSize="22" Margin="20,0" FontWeight="Medium"/>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" 
                Grid.Column="2" Height="50" Width="135">
                <Button Content="—" Click="Minimize_Click" FontSize="18" Width="45" Height="50"
                Background="Transparent" BorderBrush="Transparent" Foreground="#B0BEC5" Cursor="Hand"/>
                <Button Content="☐" Click="Maximize_Click" FontSize="16" Width="45" Height="50"
                Background="Transparent" BorderBrush="Transparent" Foreground="#B0BEC5" Cursor="Hand"/>
                <Button Content="✕" Click="Close_Click" FontSize="18" Width="45" Height="50"
                Background="Transparent" BorderBrush="Transparent" Foreground="#B0BEC5" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Utilization bar -->
        <Grid Background="#252525" Grid.Row="1" Height="40" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtProcesses" Text="- Prozesse Aktiv" Foreground="#fffafa"
                       Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Medium"/>
            <TextBlock x:Name="TxtCpu" Text="- % CPU Verbrauch" Foreground="#fffafa"
                       Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Medium"/>
            <TextBlock x:Name="TxtRam" Text="- GB Ram Verbrauch" Foreground="#fffafa"
                       Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Medium"/>
        </Grid>

        <!-- Tab content -->
        <ContentControl x:Name="TabContent" Grid.Row="1" Margin="0,41,0,0" Grid.RowSpan="2"/>
    </Grid>
</Window>
