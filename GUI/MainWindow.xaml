<Window x:Class="WindowsDebloater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:WindowsDebloater"
        mc:Ignorable="d"
        Title="MainWindow" WindowState="Maximized"
        WindowStyle= "ThreeDBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#121212">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation bar -->
        <Grid Grid.Row="0" Background="#1E1E1E" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="133*"/>
                <ColumnDefinition Width="120*"/>
                <ColumnDefinition Width="58*"/>
                <ColumnDefinition Width="126*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="104*"/>
                <ColumnDefinition Width="109*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="NavOptimization" Text="Optimierungen" Foreground="#BB86FC"
           Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
           Cursor="Hand" MouseLeftButtonDown="NavOptimization_Click" FontSize="18" Height="24" Width="120"/>
            <TextBlock x:Name="NavDataProtection" Text="Datenschutz" Foreground="#B0BEC5"
           Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
           Cursor="Hand" MouseLeftButtonDown="NavDataProtection_Click" FontSize="18" Height="24" Width="98"/>
            <TextBlock x:Name="NavApps" Text="Apps" Foreground="#B0BEC5"
           Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"
           Cursor="Hand" MouseLeftButtonDown="NavApps_Click" FontSize="18" Height="24" Width="40"/>
            <TextBlock x:Name="NavWindowsKey" Text="Windows Key" Foreground="#B0BEC5"
           Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
           Cursor="Hand" MouseLeftButtonDown="NavWindowsKey_Click" FontSize="18" Height="24" Width="106"/>
            <TextBlock x:Name="NavProfiles" Text="Profiles" Foreground="#B0BEC5"
           Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center"
           Cursor="Hand" MouseLeftButtonDown="NavProfiles_Click" FontSize="18" Height="24" Width="58"/>
            <TextBlock x:Name="NavBenchmark" Text="Benchmark" Foreground="#B0BEC5"
           Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center"
           Cursor="Hand" MouseLeftButtonDown="NavBenchmark_Click" FontSize="18" Height="24" Width="88"/>
        </Grid>


        <!-- Utilization bar -->
        <Grid Background="#1A1A1A" Margin="0,40,0,10" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtProcesses" Text="- Prozesse Aktiv" Foreground="#B0BEC5"
               Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtCpu" Text="- % CPU Verbrauch" Foreground="#B0BEC5"
               Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtRam" Text="- GB Ram Verbrauch" Foreground="#B0BEC5"
               Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtApps" Text="- Installierte Apps" Foreground="#B0BEC5"
               Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <!-- tab content -->
        <ContentControl x:Name="TabContent" Grid.Row="2"/>
    </Grid>
</Window>
